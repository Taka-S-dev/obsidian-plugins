{
  "name": "terminal-pane",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p . && node ../../scripts/build.mjs",
    "dev": "node ../../scripts/build.mjs --watch",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "plugin": {
    "entries": ["src/pty-host.ts"],
    "runtime": {
      "node-pty": ["package.json", "lib/**/*.js", "prebuilds/win32-x64/**/*.node", "prebuilds/win32-x64/**/*.exe", "prebuilds/win32-x64/**/*.dll"]
    }
  }
}
